# Optional: override the automatic platform-based API URL only when needed.
# Highest priority: applies to every platform.
# VITE_API_BASE_URL=
#
# Optional Android-specific overrides.
# Real device example:
# VITE_API_BASE_URL_ANDROID_DEVICE=http://192.168.1.111:8000
# Emulator example:
# VITE_API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:8000
#
# Fallback for all Android environments if the specific variables above are not set.
# VITE_API_BASE_URL_ANDROID=
VITE_DEV_LOGIN_EMAIL=demo@healthsync.local
VITE_DEV_LOGIN_PASSWORD=healthsync-demo
